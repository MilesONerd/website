# Normalize line endings
* text=auto

# Explicit UTF-8 text files
*.rs       text
*.md       text
*.txt      text
*.toml     text
*.yaml     text
*.yml      text
*.json     text
*.html     text
*.css      text
*.js       text
*.ts       text
*.jsx      text
*.tsx      text

# Shell scripts
*.sh       text eol=lf

# WebAssembly
*.wasm     binary

# Images
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.svg      text

# Fonts
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary

# Archives
*.zip      binary
*.tar      binary
*.gz       binary
*.xz       binary
*.7z       binary

# GitHub Linguist
*.rs linguist-language=Rust
bun.lock text linguist-generated=true
Cargo.lock text linguist-generated=true
